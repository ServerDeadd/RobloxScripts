S._conns[#S._conns+1] = RunService.Heartbeat:Connect(onStep)

function S.unload()
    if S.fling then S.fling = false; pcall(function() flingCleanup(getBall()) end) end
    if S.flyBall then pcall(function() setFly(false) end) end
    if S.autoBall then pcall(function() setAutoBall(false) end) end
    for _, c in ipairs(S._conns) do pcall(function() c:Disconnect() end) end
    S._conns = {}
    S.autoBall, S.autoGet, S.autoCatch, S.magnet = false, false, false, false
    S.antiSteal, S.flyBall, S.espBall, S.tpGrabAuto = false, false, false, false
    if S._flyBV then pcall(function() S._flyBV:Destroy() end); S._flyBV = nil end
    if S._espHL then pcall(function() S._espHL:Destroy() end); S._espHL = nil end
    if S._espBB then pcall(function() S._espBB:Destroy() end); S._espBB = nil end
    pcall(function() DeaDx:Unload() end)
    pcall(function() Window:Destroy() end)
    _G.DeadFC = nil
end

S._conns[#S._conns+1] = LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    if S.acOff then pcall(killAnticheat) end
end)

DeaDx:Notify({
