local function updateESP(ball)
    if not S.espBall then
        if S._espHL then S._espHL.Enabled = false end
        if S._espBB then S._espBB.Enabled = false end
        return
    end
    local hl = S._espHL
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name = "DeadFC_BallESP"
        hl.FillColor = Color3.fromRGB(255, 45, 64)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.35
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = huiParent()
        S._espHL = hl
    end
    local bb = S._espBB
    if not bb or not bb.Parent then
        bb = Instance.new("BillboardGui")
        bb.Name = "DeadFC_BallBB"
        bb.Size = UDim2.fromOffset(170, 42)
        bb.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
        bb.AlwaysOnTop = true
        local lbl = Instance.new("TextLabel")
        lbl.Name = "L"; lbl.BackgroundTransparency = 1; lbl.Size = UDim2.fromScale(1, 1)
        lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255); lbl.TextStrokeTransparency = 0.3
        lbl.Parent = bb
        bb.Parent = huiParent()
        S._espBB = bb
    end
    if ball then
        hl.Adornee = ball; hl.Enabled = true
        bb.Adornee = ball; bb.Enabled = true
        local _, hrp = getChar()
        local d = hrp and math.floor((hrp.Position - ball.Position).Magnitude) or 0
        bb:FindFirstChild("L").Text = string.format("Ball • %dst", d)
    else
        hl.Enabled = false; bb.Enabled = false
    end
end

local function setFly(on)
    local _, _, hum = getChar()
    local cam = Workspace.CurrentCamera
    S.flyBall = on
    if on then
        grabBall(getBall())
        if hum then
            S._flyWS = hum.WalkSpeed; S._flyJP = hum.JumpPower
            hum.WalkSpeed = 0; hum.JumpPower = 0
        end
        if cam then S._flyCamSubj = cam.CameraSubject end
        DeaDx:Notify({ Title = "Fly Ball", Content = "Ligado — câmera na bola, WASD pilota. Espaço/Ctrl sobe/desce.", Type = "Success" })
    else
        if hum then hum.WalkSpeed = S._flyWS or 16; hum.JumpPower = S._flyJP or 50 end
        if S._flyBV then pcall(function() S._flyBV:Destroy() end); S._flyBV = nil end
        if cam then cam.CameraSubject = S._flyCamSubj or hum end
    end
end

local function flingCleanup(ball)
    if S._flingBAV then pcall(function() S._flingBAV:Destroy() end); S._flingBAV = nil end
    ball = ball or getBall()
    if ball and ball:IsA("BasePart") then
        pcall(function()
            if S._flingProps then ball.CustomPhysicalProperties = S._flingProps end
            ball.Massless = false
            ball.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function setFling(on)
    S.fling = on
    if not on then flingCleanup(getBall()); return end
    local ball = getBall()
    if not ball then
        S.fling = false
        DeaDx:Notify({ Title = "Fling Ball", Content = "Não achei a bola.", Type = "Warning" })
        return
    end

    if ownerOf(ball) ~= LP then
        local _, hrp = getChar()
        if hrp and (hrp.Position - ball.Position).Magnitude <= 12 then grabBall(ball) end
    end
    DeaDx:Notify({ Title = "Fling Ball", Content = "Ligado — PRECISA de posse. Encosta a bola nos inimigos. ⚠ Risco de ban.", Type = "Warning" })
    task.spawn(function()
        local b0 = getBall()
        if b0 then S._flingProps = b0.CustomPhysicalProperties end
        while S.fling do
            local ball = getBall()
            if ball and ownerOf(ball) == LP then
                pcall(function()
                    ball.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
                    ball.Massless = true
                end)
                local bav = S._flingBAV
                if not bav or bav.Parent ~= ball then
                    if bav then pcall(function() bav:Destroy() end) end
                    bav = Instance.new("BodyAngularVelocity")
                    bav.Name = LP.Name
                    bav.MaxTorque = Vector3.new(0, math.huge, 0)
                    bav.P = math.huge
                    bav.Parent = ball
                    S._flingBAV = bav
                end
                bav.AngularVelocity = Vector3.new(0, 99999, 0)
                task.wait(0.2)
                if S._flingBAV then S._flingBAV.AngularVelocity = Vector3.new(0, 0, 0) end
                task.wait(0.1)
            else
                task.wait(0.15)
            end
        end
        flingCleanup(getBall())
    end)
end

local function killAnticheat()
    S.acPatched = 0
    local hasGC = type(getgc) == "function"
    local dbg = debug
    local canUp = dbg and type(dbg.getupvalues) == "function" and type(dbg.setupvalue) == "function"
    local canInf = dbg and type(dbg.getinfo) == "function"
    if not (hasGC and canUp and canInf) then
        return false, "executor sem getgc/debug.setupvalue"
    end
    local stub = (type(newcclosure) == "function") and newcclosure(function() return false end) or function() return false end
    for _, f in ipairs(getgc(true)) do
        if type(f) == "function" then
            local ok, ups = pcall(dbg.getupvalues, f)
            if ok and type(ups) == "table" then
                for i, up in pairs(ups) do
                    if type(up) == "function" then
                        local okn, nm = pcall(function() return dbg.getinfo(up).name end)
                        if okn and nm == "CheckBodyParts" then
                            if pcall(dbg.setupvalue, f, i, stub) then S.acPatched += 1 end
                        end
                    end
                end
            end

        end
    end

    for _, t in ipairs(getgc(true)) do
        if type(t) == "table" and rawget(t, "GetUsing") and rawget(t, "ApplyForce") and rawget(t, "ResetWelds") then
            pcall(function() t.GetUsing = function() return false end end)
            S.acPatched += 1
        end
    end
    return S.acPatched > 0, S.acPatched
end

local DEF = {
    ["Head"]=Vector3.new(2,1,1), ["Torso"]=Vector3.new(2,2,1),
    ["Right Arm"]=Vector3.new(1,2,1), ["Left Arm"]=Vector3.new(1,2,1),
    ["Right Leg"]=Vector3.new(1,2,1), ["Left Leg"]=Vector3.new(1,2,1),
}
local function bodyWatchdog()
    local c = LP.Character
    if not c then return end
    for name, sz in pairs(DEF) do
        local p = c:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            if p.Size ~= sz then pcall(function() p.Size = sz end) end
            if p.Transparency ~= 0 then pcall(function() p.Transparency = 0 end) end
        end
    end
end

local function onStep(dt)
    pcall(function()
        local char, hrp, hum = getChar()
        if not char then return end
        local ball = getBall()
        S._ball = ball
        updateESP(ball)

        if S.acOff then bodyWatchdog() end

        if not ball then return end

        if S.flyBall then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hum.WalkSpeed = 0
            local cam = Workspace.CurrentCamera
            if cam and cam.CameraSubject ~= ball then cam.CameraSubject = ball end

            local owns = ownerOf(ball) == LP
            local d3 = (ball.Position - hrp.Position).Magnitude

            if not owns and d3 <= 12 and tick() - S._tGrab > 0.5 then
                S._tGrab = tick(); grabBall(ball)
            end

            if owns then
                S._flyLost = false
                local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
                local right = cam and cam.CFrame.RightVector or Vector3.new(1, 0, 0)
                local f = (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
                local r = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
                local u = (UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0)
                        - ((UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift)) and 1 or 0)
                local move = look * f + right * r + Vector3.new(0, u, 0)
                local vel = (move.Magnitude > 0.05) and (move.Unit * S.flySpeed) or Vector3.zero
                local bv = S._flyBV
                if not bv or bv.Parent ~= ball then
                    if bv then pcall(function() bv:Destroy() end) end
                    bv = Instance.new("BodyVelocity")
                    bv.Name = LP.Name; bv.MaxForce = Vector3.new(1, 1, 1) * 1e9; bv.Parent = ball
                    S._flyBV = bv
                end
                bv.Velocity = vel
            else

                if S._flyBV then pcall(function() S._flyBV.Velocity = Vector3.zero end) end
                if not S._flyLost then
                    S._flyLost = true
                    DeaDx:Notify({ Title = "Fly Ball", Content = "Sem posse da bola — chegue perto/pegue ela primeiro. O servidor não deixa roubar de longe.", Type = "Warning" })
                end
            end
            return
        end

        local bpos = ball.Position
        local hpos = hrp.Position
        local dist3 = (bpos - hpos).Magnitude

        local horiz = Vector3.new(bpos.X - hpos.X, 0, bpos.Z - hpos.Z)
        local hd = horiz.Magnitude
        local dir = (hd > 0.05) and (horiz / hd) or hrp.CFrame.LookVector

        if S.autoBall then
            if hd > S.stopDist and hd <= S.chaseLimit then
                hum:MoveTo(Vector3.new(bpos.X, hpos.Y, bpos.Z))
            elseif hd <= S.stopDist then
                hum:MoveTo(hpos)
            end

            if S.autoBallMode == "Blatant" and dist3 <= 8 and ownerOf(ball) ~= LP then
                if tick() - S._tGrab > 1 then S._tGrab = tick(); grabBall(ball) end
            end
        end

        if S.autoGet and dist3 <= S.reachStud then
            if tick() - S._tGrab > 0.12 then
                S._tGrab = tick()
                if ownerOf(ball) ~= LP then getBallNow(ball) end
            end
        end

        if S.tpGrabAuto and not S._tpBusy and ownerOf(ball) ~= LP and tick() - S._tTp > 0.5 then
            S._tTp = tick(); tpGrab()
        end

        if S.autoCatch and isGK() and dist3 <= S.gkReach then
            local go = true
            if S.catchMode == "Legit" then

                local v = ball.AssemblyLinearVelocity
                go = (v.Magnitude > 5) and ((bpos - hrp.Position).Unit:Dot(v.Unit) < -0.25)
            end
            if go and tick() - S._tCatch > 0.15 then
                S._tCatch = tick()
                gkCatch(ball)
            end
        end

        if S.antiSteal and dist3 <= S.antiStealReach then
            if ownerOf(ball) ~= LP then
                if tick() - S._tAnti > 0.3 then S._tAnti = tick(); grabBall(ball) end
            else

                local target = hpos + hrp.CFrame.LookVector * 3 - Vector3.new(0, 1, 0)
                local d = target - bpos
                if d.Magnitude > 0.6 then pushBall(ball, d.Unit * math.min(d.Magnitude * 12, 300), 0.12) end
            end
        end

        if S.magnet and dist3 <= S.magnetReach then
            if ownerOf(ball) ~= LP and tick() - S._tGrab > 0.2 then
                S._tGrab = tick(); grabBall(ball)
            end
            local target = hrp.Position + hrp.CFrame.LookVector * 3 - Vector3.new(0, 1, 0)
            local d = target - bpos
            if d.Magnitude > 0.5 then pushBall(ball, d.Unit * math.min(d.Magnitude * 10, 260), 0.1) end
        end
    end)

end

local function doKick()
    local ball = getBall()
    if not ball then return end
    local cam = Workspace.CurrentCamera
    local dir = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)

    if ownerOf(ball) ~= LP then grabBall(ball) end
    local vel = dir * S.kickPower + Vector3.new(0, S.kickUp, 0)
    pushBall(ball, vel, 0.4)
    pcall(function() R.Client:FireServer("BallSound", ball) end)
    pcall(function() R.React:FireServer(ball, Vector3.new(1,1,1)*1e9, vel) end)
end

