local function getChar()
    local c = LP.Character
    if not c or not c.Parent then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum then return c, hrp, hum end
    return nil
end

local BALL_SIZE = Vector3.new(2.5, 2.5, 2.5)
local function scoreBall(d)
    if not (d and d.Parent) then return -1 end
    if d.Name ~= "TPS" or not d:IsA("BasePart") or d.Size ~= BALL_SIZE then return -1 end
    local s = 0
    local no = d:FindFirstChild("NetworkOwnership")
    if no and no:IsA("Script") then s += 100 end
    local sd = d:FindFirstChild("Slowdown")
    if sd and sd:IsA("Script") then s += 20 end
    if not d:FindFirstChildWhichIsA("TouchTransmitter") then s += 10 end
    if d.Parent ~= Workspace then s += 5 end
    if d.AssemblyLinearVelocity.Magnitude > 1 then s += 5 end
    local ow = d:FindFirstChild("Owner")
    if ow and ow:IsA("ObjectValue") and ow.Value then s += 3 end
    local guid = false
    for k in pairs(d:GetAttributes()) do if #k == 36 and string.find(k, "-", 1, true) then guid = true break end end
    if not guid then s += 5 end
    if d.Parent == Workspace then s -= 40 end
    return s
end

local _ballCache, _tBallScan = nil, 0
local function getBall()
    local now = tick()
    local cacheOK = _ballCache and scoreBall(_ballCache) >= 100
    if cacheOK and (now - _tBallScan) < 1 then return _ballCache end
    _tBallScan = now
    local best, bestS = nil, 0
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == "TPS" then
            local sc = scoreBall(d)
            if sc > bestS then best, bestS = d, sc end
        end
    end
    if best and bestS > 0 then
        _ballCache = best
    elseif not cacheOK then
        _ballCache = nil
    end
    return _ballCache
end

local function isGK()
    local c = LP.Character
    if not c then return false end
    if c:FindFirstChild("ValueGKMPS") then return true end
    local t = LP.Team
    return t and (t.Name == "-Home GK" or t.Name == "-Away GK") or false
end

local function ownerOf(ball)
    local o = ball:FindFirstChild("Owner")
    return o and o.Value or nil
end

local function pushBall(ball, velocity, life)
    for _, ch in ipairs(ball:GetChildren()) do
        if ch:IsA("BodyVelocity") and ch.Name == LP.Name then ch:Destroy() end
    end
    local bv = Instance.new("BodyVelocity")
    bv.Name = LP.Name
    bv.Velocity = velocity
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e9
    bv.Parent = ball
    Debris:AddItem(bv, life or 0.3)
    return bv
end

local function grabBall(ball)
    ball = ball or getBall()
    if not ball then return end
    pcall(function() R.ChangeOwner:FireServer(ball, "Tackle") end)
    pcall(function() R.Client:FireServer("BallSound", ball) end)
end

local function getBallNow(ball)
    ball = ball or getBall()
    if not ball then return end
    grabBall(ball)
    local _, hrp = getChar()
    if hrp then
        local to = hrp.Position - ball.Position
        if to.Magnitude > 1 then
            pushBall(ball, to.Unit * math.min(to.Magnitude * 6, 220), 0.25)
        end
    end
end

local function tpGrab()
    if S._tpBusy then return end
    local ball = getBall()
    local _, hrp = getChar()
    if not ball or not hrp then return end
    S._tpBusy = true
    task.spawn(function()
        local saved = hrp.CFrame
        hrp.CFrame = CFrame.new(ball.Position - Vector3.new(0, S.tpDrop, 0))
        task.wait(S.tpHold)
        grabBall(getBall() or ball)
        task.wait(0.03)
        if hrp and hrp.Parent then hrp.CFrame = saved end
        local b = getBall()
        if b and hrp and hrp.Parent then
            local to = hrp.Position - b.Position
            if to.Magnitude > 1 then pushBall(b, to.Unit * math.min(to.Magnitude * 8, 300), 0.3) end
        end
        S._tpBusy = false
    end)
end

local function gkCatch(ball)
    ball = ball or getBall()
    if not ball then return end
    pcall(function() R.ChangeOwner:FireServer(ball, "Tackle") end)
    pcall(function() R.Client:FireServer("BallSound", ball) end)
    pcall(function() R.ApplyGKReact:FireServer(ball, ball.CFrame) end)
    pcall(function() R.CatchBall:FireServer(ball) end)
end

